# Build artifacts
/target
/crates/site/target
/crates/site/dist
/crates/site/public/receipts/*
!/crates/site/public/receipts/.gitkeep
# The architecture tree `asbuilt docs` writes for the landing site, and the
# rendered views: build output. model.c4 is the source of truth.
/crates/site/public/architecture/*
!/crates/site/public/architecture/.gitkeep
/docs/architecture/views/

# cargo-mutants output (current run + rotated previous run)
/mutants.out/
/mutants.out.old/

# Environment variables (secrets, config)
.env

# Agent skills installed with `npx skills add`. skills-lock.json is the
# tracked pin; the content is fetched, so it is not vendored here. The CLI
# writes the skill under .agents/skills/ and links it from .claude/skills/
# (or writes it there directly), and a tracked copy would drift against
# panschema.
/.agents/skills/
/.claude/skills/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
