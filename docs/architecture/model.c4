  color theme_tests #eef1f5
  element bin {
    style {
      color theme_bin
    }
  }
  element component {
    style {
      color theme_component
    }
  }
  element container {
    style {
      color theme_container
    }
  }
  element tests {
    style {
      color theme_tests
    }
  }
  tag bin
  tag tests
  relationship implements {
    line solid
    head onormal
  }
  relationship constructs {
    line solid
    head diamond
  }
  relationship calls {
    line solid
    head vee
  }
  relationship names {
    line dotted
    head dot
  }
  relationship uses {
    line dotted
    head odot
  }
}

